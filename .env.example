# Token usado pela Meta para validar o GET do webhook.
WHATSAPP_VERIFY_TOKEN=fieldops-dev

# Credenciais da WhatsApp Cloud API. Nunca faça commit de valores reais.
WHATSAPP_ACCESS_TOKEN=cole-o-token-novo-aqui
WHATSAPP_PHONE_NUMBER_ID=cole-o-phone-number-id-aqui

# Opcional: a versão da Graph API usada pela Meta.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TIMEOUT=15

# Opcional: Groq para reescrever respostas.
GROQ_API_KEY=cole-a-chave-do-groq-aqui
GROQ_MODEL=llama-3.1-8b-instant
